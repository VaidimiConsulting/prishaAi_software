# Is file ka naam ".env" rakhkar apni values bharo. .env ko kabhi kisi ke saath share mat karo.

# ===== Calculator (MySQL / Admin / Email) =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
PORT=3001
ADMIN_USER=admin
ADMIN_PASS=change-this-password
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_USER=info@yourdomain.com
MAIL_PASS=your_mail_password
MAIL_FROM="Prisha Interiors <info@yourdomain.com>"
ADMIN_EMAIL=info@yourdomain.com

# ===== AI Design Studio =====
OPENAI_API_KEY=sk-proj-your-key-here
# gpt-image-1 = best exactness (gpt-image-1-mini = tez/sasta)
IMAGE_MODEL=gpt-image-1
# low (sabse tez) | medium | high
IMAGE_QUALITY=low
# ek baar me max kitni images
MAX_IMAGES=8
# Login security: koi bhi lamba random text (khali chhodo to khud ban jata hai)
JWT_SECRET=
# Google/Gmail login (optional): https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origin me apna domain daalo (local: http://localhost:5173 aur http://localhost:3001)
GOOGLE_CLIENT_ID=
